# Use launcher for Rocket League/PsyNet auth. Custom OAuth is useful for
# experimenting with your own Epic client, but normal clients cannot create
# the Rocket League exchange code this app needs.
EPIC_AUTH_MODE=launcher

# Only needed when EPIC_AUTH_MODE=custom.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost:6767/epic/callback
EPIC_SCOPE=basic_profile
